# Copy to .env (never commit the real file) or set these in your hosting provider's settings.

# Required for AI features (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: Google Safe Browsing v4 key for known-dangerous-website lists
GOOGLE_SAFE_BROWSING_KEY=

# Strongly recommended in production: only your installed extension may call this server.
# Find the ID on chrome://extensions (Developer mode on).
ALLOWED_ORIGINS=chrome-extension://your-extension-id-here

# Optional shared code entered in EasyAccess Settings → AI helper → Access code
EASYACCESS_ACCESS_CODE=

# Optional tuning
EASYACCESS_MODEL=claude-opus-5-5
EASYACCESS_EFFORT=low
RATE_LIMIT_PER_MINUTE=20
PORT=8787
HOST=127.0.0.1
